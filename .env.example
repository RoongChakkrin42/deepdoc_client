# Base URL the browser calls deepdoc_server on.
#
# NEXT_PUBLIC_ variables are substituted into the browser bundle at BUILD time,
# not read at runtime — setting this as a container env var does nothing. The
# deployed image is built with `/api` and served behind an ingress that routes
# /api to the API, which keeps one image valid everywhere and means the browser
# never makes a cross-origin request.
#
# For local development, point it at the API directly.
#
# Note that .env.local overrides this file. If requests go somewhere
# unexpected, check .env.local first.
NEXT_PUBLIC_BACKENDURL=http://localhost:8000
